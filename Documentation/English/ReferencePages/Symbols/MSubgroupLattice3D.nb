Cell[BoxData[
 InterpretationBox[Cell[
  "CombinationsLimit", "ExampleSubsection",ExpressionUUID->
   "0c053e0d-5d65-274a-8573-b862d72f0653"],
  $Line = 0; Null]], "ExampleSubsection",
 CellChangeTimes->{{3.9579128806052*^9, 3.9579128806052*^9}},
 CellID->444255716,ExpressionUUID->"bdf31cf1-98db-2248-94c6-25731bd6d4cb"],

Cell[TextData[{
 "CombinationsLimit can be set to define the maximum cardinality of subsets \
that should be used to generate subgroups. For example, all subgroups of ",
 Cell[BoxData[
  SubscriptBox["S", "4"]], "InlineFormula",ExpressionUUID->
  "e651af4d-7d65-ee4d-a290-0e6141b09fca"],
 " can be generated by a maximum of 2 elements as the rank of this group is \
2. Hence, compare the default value:"
}], "ExampleText",
 CellChangeTimes->{{3.956725356230221*^9, 3.9567254166430225`*^9}},
 CellID->556403549,ExpressionUUID->"f82c6930-3ce4-a14c-b5e6-57ac60418776"],

