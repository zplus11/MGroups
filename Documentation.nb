Cell[CellGroupData[{

Cell["Defining a Group", "Subsection",
 CellChangeTimes->{{3.9328613479922185`*^9, 
  3.932861361747616*^9}},ExpressionUUID->"6ad951fc-f301-41bb-8b60-\
ac745fad3557"],

Cell["Groups can be freely formed with the following command:\[LongDash]", \
"Text",
 CellChangeTimes->{{3.9328613637326946`*^9, 
  3.932861385269655*^9}},ExpressionUUID->"909359d7-4be4-462c-8ea8-\
d476728ad6a1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"domain", ":=", 
  RowBox[{"{", "0", "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"function", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{"x", "+", "y"}]}], "\[IndentingNewLine]", 
 RowBox[{"FormGroup", "[", 
  RowBox[{"domain", ",", "function"}], "]"}]}], "Input",
 CellChangeTimes->{{3.932861416784383*^9, 3.932861435966904*^9}, {
  3.9448740954690003`*^9, 3.9448740956578193`*^9}, {3.9468055178659735`*^9, 
  3.9468055225105896`*^9}, {3.9489414589245977`*^9, 3.948941482584366*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"07d4c68c-73d3-41a1-9768-0072765c4b11"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{"0", "\[Rule]", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"0", "\[Rule]", "0"}], "\[RightAssociation]"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{3.9328614474838037`*^9, 3.9328617656541476`*^9, 
  3.9328634026348143`*^9, 3.9351212629959044`*^9, 3.944874681959651*^9, 
  3.9468055629954853`*^9, 3.9468627780266743`*^9, 3.9468629926962185`*^9, 
  3.948941489137349*^9, 3.9489417741156535`*^9, 3.949025598407197*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"688d233d-a39b-4bd9-8d79-86c6697e6268"]
}, Open  ]],

Cell[TextData[{
 "without having to type out the Associations yourself. Here, the first \
argument ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "0", "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "32b08601-c99c-48a8-8825-49be9ef2453c"],
 " is the domain, and the second argument is the binary operator that takes \
two arguments and returns their sum. The resulting group is just the \
singleton zero ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "0", "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6f384965-fb19-4746-bd72-d70b9b410ed3"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"0", "+", "0"}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "16d1771c-3445-4059-af2c-205b6c4f6296"],
 "."
}], "Text",
 CellChangeTimes->{{3.932861454001618*^9, 3.9328614661027317`*^9}, {
  3.9468614723784184`*^9, 
  3.9468615478759604`*^9}},ExpressionUUID->"ca84aeef-dc04-4958-8eae-\
3faeb6894716"]
}, Open  ]],

