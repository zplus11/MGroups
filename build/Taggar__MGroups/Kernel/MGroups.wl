Begin["`Private`"]


MapToAssociationQ[_->_?AssociationQ] := True
MapToAssociationQ[___] := False
(* MGroup should be an association that maps elements to nested associations *)
MGroupQ[MGroup@Association[___?MapToAssociationQ]] := True
MGroupQ[___] := False


MGroup /: MakeBoxes[G_MGroup, form: TraditionalForm] := 
    Module[{domain = MGroupDomain[G],
    dr},
		dr = If[Length@domain > 5,
			(* a1, a2, ..., an *)
			"{"<>ToString@domain[[1]]<>", "<>
				ToString@domain[[2]]<>",..., "<>
				Last@dr<>"}",
			(* else the domain *)
			ToString@domain
		];
        ToBoxes[
            "MGroup["<>dr<>"]"
        ]
    ];

MGroup /: MakeBoxes[G_MGroup, form: StandardForm] := 
    Module[{above, below, icon},
        icon = Graphics[{
			EdgeForm[Black],
            FaceForm[LightBlue],
            Rectangle[],
            Text[Style["G", Black, 14], {0.5, 0.5}]
        }, ImageSize -> {30, 30}];
        above = {
            BoxForm`SummaryItem[{"Operation: ", "Binary", SpanFromLeft}],
            BoxForm`SummaryItem[{"Order: ", MGroupOrder@G}]
        };
        below = {
            BoxForm`SummaryItem[{"Identity: ", MGroupIdentity@G}]
        };
        BoxForm`ArrangeSummaryBox[
            "MGroup", G, icon, above, below, form,
            "Interpretable" -> True
        ]
    ];


mgClosure[g_, f_] := 
	AllTrue[Tuples[g, 2], MemberQ[g, f @@ #] &]
mgInverses[g_, f_] := Module[
	{id},
	id = Select[g, Function[e, AllTrue[g, f[e, #] === # === f[#, e] &]]];
	id = If[Length[id] == 1, First[id], Return[Missing["NoUniqueIdentity"]]];
	AllTrue[g, Function[x,
		AnyTrue[g, f[x, #] === id === f[#, x] &]
	]]
]
mgAssociativity[g_, f_] :=
	AllTrue[Tuples[g, 3],
		f[f[#[[1]], #[[2]]], #[[3]]] == f[#[[1]], f[#[[2]], #[[3]]]]&
	]


MSemiGroupQ[g_, f_] := mgClosure[g, f] && mgAssociativity[g, f]
MMonoidQ[g_, f_] := mgClosure[g, f] && Module[
	{id},
	id = Select[g, Function[e, AllTrue[g, f[e, #] === # === f[#, e] &]]];
	Length @ id == 1
]


FormMGroup::inv="The domain and function do not form a group."
FormMGroup[domain_List, binop_, check_: True] := 
	If[check == True,
		If[mgClosure[domain, binop] &&
			mgInverses[domain, binop] &&
			mgAssociativity[domain, binop],
			MGroup@
				Association@Table[
					x -> Association@Table[
					y -> binop[y, x], {y, domain}
				], {x, domain}
			],
			Message[FormGroup::inv]],
		MGroup@
			Association@Table[
				x -> Association@Table[
				y -> binop[y, x], {y, domain}
			], {x, domain}
		]]
MGroupData[MGroup[data_]] := data
MGroup /: g_MGroup[key1_][key2_] := MGroupData[g][key1][key2]
MGroupDomain[G_?MGroupQ] := Keys@MGroupData@G
MGroupIdentity[G_?MGroupQ] := With[
	{domain = MGroupDomain@G},
	SelectFirst[domain, And@@Table[G[#][y] == y, {y, domain}] & ]
]


MElementPower::pown="The argument `1` is not a valid integer."
MElementPower::notin="The argument `1` is not a valid member of the group."
MElementPower[G_?MGroupQ, element_, power_] := Module[
	{domain = MGroupDomain[G]},
	If[
	!MemberQ[domain, element],
		Message[MElementPower::notin, element]; Return[$Failed]];
	If[
	!IntegerQ[power],
		Message[MElementPower::pown, power]; Return[$Failed]];
	Which[
		power == 0, MGroupIdentity[G],
		power > 0, Nest[G[#][element] &, element, power - 1],
		(* x ^ (-n) = (x ^ (-1)) ^ n *)
		power < 0,
		With[{inv = MElementInverse[G, element]},
			Nest[G[#][inv] &, inv, -power - 1]
		]
	]
]

MElementPower[G_?MGroupQ, elements_List, power_] := Module[
	{domain = MGroupDomain[G]},
	Do[If[
	!MemberQ[domain, element],
		Message[MElementPower::notin, element]; Return[$Failed]],
		{element, elements}];
	If[
	!IntegerQ[power],
		Message[MElementPower::pown, power]; Return[$Failed]];
	Which[
		power == 0, Table[MGroupIdentity[G], {i, elements}],
		power > 0, Table[Nest[G[#][element] &, element, power - 1], {element, elements}],
		(* x ^ (-n) = (x ^ (-1)) ^ n *)
		power < 0,
		Table[With[{inv = MElementInverse[G, element]},
			Nest[G[#][inv] &, inv, -power - 1]
		], {element, elements}]
	]
]

MElementPower[G_?MGroupQ, element_, powers_List] := Module[
	{domain = MGroupDomain[G]},
	If[
	!MemberQ[domain, element],
		Message[MElementPower::notin, element]; Return[$Failed]];
	Do[If[
	!IntegerQ[power],
		Message[MElementPower::pown, power]; Return[$Failed]],
		{power, powers}];
	Table[Which[
		power == 0, MGroupIdentity[G],
		power > 0, Nest[G[#][element] &, element, power - 1],
		(* x ^ (-n) = (x ^ (-1)) ^ n *)
		power < 0,
		With[{inv = MElementInverse[G, element]},
			Nest[G[#][inv] &, inv, -power - 1]
		]
	], {power, powers}]
]


MGroupOrder[G_?MGroupQ] := Length@MGroupDomain@G
MElementOrder::notin="The argument `1` is not a valid member of the group."
MElementOrder[G_?MGroupQ, element_] := Module[
    {identity = MGroupIdentity@G},
	If[!MemberQ[MGroupDomain[G], element],
		Message[MElementOrder::notin, element]; Return[$Failed],
		FirstCase[
            Divisors[MGroupOrder@G],
            i_ /; MElementPower[G, element, i] == identity :> i,
            Null
        ]
	]
]
MElementOrder[G_?MGroupQ, elements_List] := Module[
    {identity = MGroupIdentity@G},
	Do[If[!MemberQ[MGroupDomain[G], element],
		Message[MElementOrder::notin, element];Return[$Failed]],
		{element, elements}];
	Table[
		FirstCase[
            Divisors[MGroupOrder@G],
            i_ /; MElementPower[G, element, i] == identity :> i,
            Null
        ], {element, elements}
	]
]


MElementInverse::notin="The argument `1` is not a valid member of the group."
MElementInverse[G_?MGroupQ, element_] := Module[
    {identity = MGroupIdentity@G},
    If[!MemberQ[MGroupDomain[G], element],
		Message[MElementInverse::notin, element],
	    FirstCase[
	        MGroupDomain@G,
	        x_ /; G[element][x] == identity :> x,
	        Null
	    ]
	]
]
MElementInverse[G_?MGroupQ, elements_List] := Module[
    {identity = MGroupIdentity@G},
    Do[If[!MemberQ[MGroupDomain[G], element],
		Message[MElementInverse::notin, element];Return[$Failed]],
		{element, elements}];
	Table[
		FirstCase[
	        MGroupDomain@G,
	        x_ /; G[element][x] == identity :> x,
	        Null
	    ], {element, elements}]
	]


MCyclicQ[G_?MGroupQ] := Module[
    {grouporder = MGroupOrder[G]},
    (* Groups of prime order are always cyclic, hence if so: *)
    If[PrimeQ[grouporder], True,
    (* else: *)
        FirstCase[
            MGroupDomain[G],
            x_ /; MElementOrder[G, x] == grouporder :> True,
            False
        ]
    ]
]
MCyclicQ::subset="The argument `1` is not a valid subset of the group."
MCyclicQ[G_?MGroupQ, H_List] := If[!SubsetQ[MGroupDomain[G], H],
	Message[MCyclicQ::subset, H],
	With[{o = Length@H},
	    (* Groups of prime order are always cyclic, hence if so: *)
	    If[PrimeQ@o, True,
	    (* else: *)
	        FirstCase[
	            H,
	            x_ /; MElementOrder[G, x] == o :> True,
	            False
	        ]
	    ]
	]
]


MAbelianQ[G_?MGroupQ] := Module[
	{domain = MGroupDomain@G},
	(* again, a group of prime order is abelian, thus: *)
	If[PrimeQ[MGroupOrder@G], True,
		(* else: *)
		Catch[
			Do[If[G[x][y] != G[y][x], Throw@False], 
				{x, domain}, {y, domain}];
			Throw@True
		]
	]
]
MAbelianQ::subset="The argument `1` is not a valid subset of the group."
MAbelianQ[G_?MGroupQ, H_List] := If[!SubsetQ[MGroupDomain[G], H],
	Message[MAbelianQ::subset, H],
	(* again, a group of prime order is abelian, thus: *)
	If[PrimeQ[Length@H], True,
		(* else *)
		Catch[
			Do[If[G[x][y] != G[y][x], Throw@False], 
				{x, H}, {y, H}];
			Throw@True
		]
	]
]


MCayleyTable[G_?MGroupQ] := Module[
	{domain,data},
	domain = MGroupDomain@G;
	TableForm[Table[Table[G[x][y], {y, domain}], {x, domain}],
	TableHeadings -> {domain, domain}, TableDepth -> 2]
]


MCayleyGraph[G_?MGroupQ, gen_List] := Module[
	{ed, col, domain = MGroupDomain[G]},
	col = AssociationThread[gen ->
		(ColorData["Rainbow", #]& /@ Rescale@Range@Length@gen)];
	ed = Flatten[Table[
		Table[{y \[DirectedEdge] G[y][x], x}, {y, domain}],
		{x, gen}
	], 1];
	Graph[
		MGroupDomain[G],
		ed[[All, 1]],
		EdgeStyle -> (#[[1]] -> col@#[[2]]& /@ ed),
		VertexLabels -> Placed["Name", Tooltip],
		DirectedEdges -> False
	]
]

MCayleyGraph3D[G_?MGroupQ, gen_List] := Module[
	{ed, col, domain = MGroupDomain[G]},
	col = AssociationThread[gen ->
		(ColorData["Rainbow", #]& /@ Rescale@Range@Length@gen)];
	ed = Flatten[Table[
		Table[{y \[DirectedEdge] G[y][x], x}, {y, domain}],
		{x, gen}
	], 1];
	Graph3D[
		MGroupDomain[G],
		ed[[All, 1]],
		EdgeStyle -> (#[[1]] -> col@#[[2]]& /@ ed),
		VertexLabels -> Placed["Name", Tooltip],
		DirectedEdges -> False
	]
]


MInversesTable[G_?MGroupQ] := Module[
	{domain},
	domain = MGroupDomain@G;
	TableForm[Table[{x, MElementInverse[G, x], MElementOrder[G, x]}, 
		{x, domain}],
	TableHeadings -> {None, {"x", 
		"\!\(\*SuperscriptBox[\(x\), \(-1\)]\)", 
		"|x|=|\!\(\*SuperscriptBox[\(x\), \(-1\)]\)|"}},
		TableDepth -> 2]
]


MGenerateSubgroup::subset="The argument is not a valid element or set of elements from the group."
MGenerateSubgroup[G_?MGroupQ, elements_List] := Module[
	{iden = MGroupIdentity[G],
	domain = MGroupDomain[G],
	H, Q, x, pr},
	(* Elements must be coming from the group, *)
	If[!SubsetQ[domain, elements],
		Message[MGenerateSubgroup::subset, elements]; $Failed,
		(* then: *)
		(* initiate the subgroup and a queue *)
		H = {iden};
		Q = {iden};
		While[
			(* the queue is non-empty *)
			Length[Q] > 0,
			x = First[Q];
			Q = Rest[Q];
			Do[
				(* keep appending s x to the queue if it isn't in the 
					subgroup already *)
				pr = G[x][s];
				If[!MemberQ[H, pr],
					AppendTo[H, pr];
					AppendTo[Q, pr];
				],
				{s, elements}
			];
		];
		Sort@H
	]
]
MGenerateSubgroup[G_?MGroupQ, element_] :=
	MGenerateSubgroup[G, {element}]


MSubgroupQ::subset="The argument `1` is not a valid subset of the group."
MSubgroupQ[G_?MGroupQ, H_List] := Module[
	{domain = MGroupDomain@G,
	identity = MGroupIdentity@G},
	If[!SubsetQ[domain, H],
		Message[MSubgroupQ::subset, H]; $Failed,
		Catch[
			(* subgroup ought to: have identity; *)
			If[!MemberQ[H, identity], Throw@False];
			(* and be closed under the operation of group itself. *)
			Do[If[!MemberQ[H, G[x][y]], Throw@False], {x, H}, {y, H}];
			(* Furthermore, by Lagrange theorem we can also discard H
				if its order does not divide the order of group itself,
				hence: *)
			If[!MemberQ[Divisors @ Length[domain],
				Length[H]], Throw@False];
			Throw@True
		]
	]
]


(* a helper function to calculate the subgroups *)
FindSubgroups[G_, r_:3] := Module[
    {domain = MGroupDomain[G], div, gen},
    (* We check if the group is cyclic: *)
	gen = Null;
	Do[
		If[MGenerateSubgroup[G, {x}] == domain,
		gen = x],
		{x, domain}
	];
	(* if so: *)
	If[gen =!= Null,
		(* we apply the fundamental theorem of cyclic groups to
			exhibit subgroups using powers of the generator corresponding
			to each divisor d of group's order: *)
		div = Divisors@MGroupOrder@G;
		Table[
			With[{pow = MElementPower[G, gen, i]},
				{MGenerateSubgroup[G, {pow}], pow}],
			{i, div}],
		(* else-wise, we return unique subgroups generated by each subset A
			of G having cardinality less than or equal to r: *)
		DeleteDuplicatesBy[
			Table[{MGenerateSubgroup[G, gen], gen}, {gen, Subsets[domain, {1, r}]}],
			#[[1]] &
		]
	]
]
Options[MSubgroups] = {MCombinationsLimit -> 3};
MSubgroups[G_?MGroupQ, OptionsPattern[]] := With[
	{subs = FindSubgroups[G, OptionValue[MCombinationsLimit]]},
	TableForm[subs,
	TableHeadings -> {None, {"Subgroup", "Generated by"}},
		TableDepth -> 2]
]		


showinfoAll[sub_] := Grid[{
	{sub[[1]]},
	{"Generated by "<>ToString[sub[[2]]]},
	{"Order = "<>ToString @ Length @ sub[[1]]}
}, Frame -> All]
showinfoNotAll[sub_] := ToString[sub[[2]]]

Options[MSubgroupLattice] = {MHighlight -> "All", MShowInfo -> "All", MCombinationsLimit -> 3};
MSubgroupLattice[G_?MGroupQ, OptionsPattern[]] := Module[
	{subgroups, rel, colourRule},
	
	colourRule = If[
		OptionValue[MHighlight] === "All",
			(# -> RGBColor["#4983FE"]) &,
			(# -> If[
				OptionValue[MHighlight][G, #[[1]]],
					RGBColor["#4983FE"], LightGray
			]) &
	];
  
	subgroups = FindSubgroups[G, OptionValue[MCombinationsLimit]];
	rel = Select[Tuples[subgroups, 2], SubsetQ[#[[1]][[1]], #[[2]][[1]]] &];
	
	LayeredGraphPlot[
		EdgeList @ TransitiveReductionGraph[Rule @@@ rel],
		VertexStyle -> colourRule/@subgroups,
		VertexSize -> Medium,
		VertexLabels -> If[OptionValue[MShowInfo] == "All",
				(#->Placed[showinfoAll[#], Tooltip]&/@subgroups),
				(#->showinfoNotAll[#]&/@subgroups)],
		EdgeStyle -> Gray
	]
];

Options[MSubgroupLattice3D] = {MHighlight -> "All", MShowInfo -> "All", MCombinationsLimit -> 3};
MSubgroupLattice3D[G_?MGroupQ, OptionsPattern[]] := Module[
	{subgroups, rel, colourRule},
	
	colourRule = If[
		OptionValue[MHighlight] === "All",
			(# -> RGBColor["#4983FE"]) &,
			(# -> If[
				OptionValue[MHighlight][G, #[[1]]],
					RGBColor["#4983FE"], LightGray
			]) &
	];
  
	subgroups = FindSubgroups[G, OptionValue[MCombinationsLimit]];
	rel = Select[Tuples[subgroups, 2], SubsetQ[#[[1]][[1]], #[[2]][[1]]] &];
	
	LayeredGraphPlot3D[
		EdgeList @ TransitiveReductionGraph[Rule @@@ rel],
		VertexStyle -> colourRule/@subgroups,
		VertexLabels -> If[OptionValue[MShowInfo] == "All",
				(#->Placed[showinfoAll[#], Tooltip]&/@subgroups),
				(#->showinfoNotAll[#]&/@subgroups)],
		EdgeStyle -> LightGray
	]
];


MCoset::notin="The argument `1` is not a valid member of the group."
MCoset::subs="The argument `1` is not a valid normal subgroup of the group."
MCoset::orien="The third argument expects 'l' or 'r', received `1`."

MCoset[G_?MGroupQ, H_, element_, orientation_ : "l"] := Module[
    {domain = MGroupDomain@G},
    If[!MSubgroupQ[G, H],
		Message[MCoset::subs, H]; Return[$Failed]];
	If[!MemberQ[domain, element],
		Message[MCoset::notin, element]; Return[$Failed]];
	If[!MemberQ[{"l", "r"}, orientation],
		Message[MCoset::orien, orientation]; Return[$Failed]];
    If[orientation == "l",
            G[#][element] & /@ H,
            G[element][#] & /@ H
        ]
]


MNormalSubgroupQ::sub="The argument `1` is not a valid subgroup of the group."
Options[MNormalSubgroupQ] = {CheckSub -> True};
MNormalSubgroupQ[G_?MGroupQ, H_] := Module[
	{domain = MGroupDomain@G},
	Catch[If[OptionValue[CheckSub],
		If[!MSubgroupQ[G, H],
			Message[MNormalSubgroupQ::sub, H]; Return[$Failed]]];
	Do[If[
		Sort[MCoset[G, H, x, "l"]]
		=!= Sort[MCoset[G, H, x, "r"]],
		Throw[False]
	],
	{x, domain}];
	Throw@True]
]


Options[MNormalSubgroups] = {MCombinationsLimit -> 3};
MNormalSubgroups[G_?MGroupQ, OptionsPattern[]] := Module[
	{subgroups},
	subgroups = FindSubgroups[G, OptionValue[MCombinationsLimit]];
	TableForm[
		Select[subgroups, MNormalSubgroupQ[G, #[[1]]] & ],
		TableHeadings -> {None, {"Subgroup", "Generated by"}},
			TableDepth -> 2]
]


MFactorGroup::nsub="The argument `1` is not a valid normal subgroup of the group."
MFactorGroup[G_?MGroupQ, H_] := Module[
	{domain = MGroupDomain@G, csc, ur, map},
	If[!MNormalSubgroupQ[G, H],
		Message[MFactorGroup::nsub, H]; Return[$Failed]];
	csc = <|Table[el -> Table[G[x][el], {x, H}], {el, domain}]|>;
	ur = DeleteDuplicatesBy[
		domain,
		Sort@csc[#] &
	];
	Do[
		map[x] = SelectFirst[ur, Sort@csc[x] == Sort@csc[#] &],
		{x, domain}
	];
	FormMGroup[ur, map[G[#1][#2]] &, False]
]


MGroupCenter[G_?MGroupQ] := Module[
	{domain = MGroupDomain@G},
	Select[domain,
		And@@Table[G[#][y] == G[y][#], {y, domain}] &]
]
MElementCentralizer[G_?MGroupQ, elem_] := Module[
	{domain = MGroupDomain@G},
	Select[domain, G[#][elem] == G[elem][#] & ]
]


MAdditiveGroup[n_Integer] := FormMGroup[Range[0, n-1], Mod[#1+#2, n] &, False]


MMultiplicativeGroup[n_Integer] := FormMGroup[
	Select[Range[n-1], GCD[#, n] == 1 & ],
	Mod[#1 #2, n] &,
	False
]


applySymmetry[{s1_, s2_}, n_] := Module[
    {h1, h2, n1, n2, op},
    {h1, n1} = {StringTake[s1, 1], ToExpression@StringDrop[s1, 1]};
    {h2, n2} = {StringTake[s2, 1], ToExpression@StringDrop[s2, 1]};
    
    op = If[h1 == "r",
        If[h2 == "r", {"r", Mod[n1 + n2, n]}, {"s", Mod[n1 + n2, n]}],
        If[h2 == "r", {"s", Mod[n1 - n2, n]}, {"r", Mod[n1 - n2, n]}]
    ];
    
    StringJoin[op[[1]], ToString[op[[2]]]]
]
s2n[string_] := Read[StringToStream[string], Number]
MDihedralGroup[n_] := Module[
	{members},
	members = Table["r" <> ToString[i], {i, 0, n-1}] ~
		Union ~
		Table["s" <> ToString[i], {i, 0, n-1}];
	FormMGroup[members, applySymmetry[{#1, #2}, n] &, False]
]


permrepr[perm_Cycles] := If[perm === Cycles[{}], "(1)", 
		"(" <> StringJoin[ToString/@#] <> ")" &/@First@perm // StringJoin
	]
permrepr[perm_List] := Module[
	{cycles = PermutationCycles[perm]},
	If[cycles === Cycles[{}], "(1)", 
		"(" <> StringJoin[ToString/@#] <> ")" &/@First@cycles // StringJoin
	]
]
MCycleForm[perm_] := With[
	{cases = StringCases[perm,RegularExpression["\\((\\d+)\\)"]->"$1"]},
	Cycles@ToExpression[StringSplit[#,""]&/@cases]
]
MPermutationsGroup[n_Integer] := With[
	{domain = Permutations@Range@n},
	MGroup@
		Association@Table[
			permrepr@x -> Association@Table[
				permrepr@y -> permrepr@PermutationProduct[y, x],
				{y, domain}
			], {x, domain}
		]
    ]
MPermutationsGroup[perms___List] := MGroup@
		Association@Table[
			permrepr@x -> Association@Table[
				permrepr@y -> permrepr@PermutationProduct[y, x],
				{y, perms}
			], {x, perms}
		]


MKlein4Group:=MGroup@<|
	"e" -> <|"e" -> "e", "a" -> "a", "b" -> "b", "c" -> "c"|>,
	"a" -> <|"e" -> "a", "a" -> "e", "b" -> "c", "c" -> "b"|>,
	"b" -> <|"e" -> "b", "a" -> "c", "b" -> "e", "c" -> "a"|>,
	"c" -> <|"e" -> "c", "a" -> "b", "b" -> "a", "c" -> "e"|>
|>


MQuaternionGroup:=MGroup@<|
	"1" -> <|"1" -> "1", "-1" -> "-1", "i" -> "i", "-i" -> "-i", "j" -> "j", "-j" -> "-j", "k" -> "k", "-k" -> "-k"|>,
	"-1" -> <|"1" -> "-1", "-1" -> "1", "i" -> "-i", "-i" -> "i", "j" -> "-j", "-j" -> "j", "k" -> "-k", "-k" -> "k"|>,
	"i" -> <|"1" -> "i", "-1" -> "-i", "i" -> "-1", "-i" -> "1", "j" -> "k", "-j" -> "-k", "k" -> "-j", "-k" -> "j"|>,
	"-i" -> <|"1" -> "-i", "-1" -> "i", "i" -> "1", "-i" -> "-1", "j" -> "-k", "-j" -> "k", "k" -> "j", "-k" -> "-j"|>,
	"j" -> <|"1" -> "j", "-1" -> "-j", "i" -> "-k", "-i" -> "k", "j" -> "-1", "-j" -> "1", "k" -> "i", "-k" -> "-i"|>,
	"-j" -> <|"1" -> "-j", "-1" -> "j", "i" -> "k", "-i" -> "-k", "j" -> "1", "-j" -> "-1", "k" -> "-i", "-k" -> "i"|>,
	"k" -> <|"1" -> "k", "-1" -> "-k", "i" -> "j", "-i" -> "-j", "j" -> "-i", "-j" -> "i", "k" -> "-1", "-k" -> "1"|>,
	"-k" -> <|"1" -> "-k", "-1" -> "k", "i" -> "-j", "-i" -> "j", "j" -> "i", "-j" -> "-i", "k" -> "1", "-k" -> "-1"|>
|>


(* We wrap the elements of EDP --- that are in list form --- using
	an MTuple head, to avoid conflicts with list manipulations and
	pattern matchings elsewhere. Note for example, that
	MElementInverse[G, {0, 1}] otherwise could be taken to mean inverses
	of 0 and 1, AND inverse of tuple {0, 1} as well. *)
MTuple /: MTuple[elems_][[i_]] := elems[[i]]
MTuple /: Format[MTuple[elems_]] := "(" <> StringRiffle[elems, ", "] <> ")"

MEDP[groups___?MGroupQ] := With[
	(* number of groups in question: *)
	{n = Length @ {groups}},
	(* Forming the group: *)
	FormMGroup[
		(* with elements being tuples of groups *)
		MTuple /@ Tuples[MGroupDomain /@ {groups}],
		(* and the operation being component wise *)
		MTuple@Table[{groups}[[i]][#1[[i]]][#2[[i]]], {i, n}] &,
		False
	]
]


MMorphismQ[MMorphism[assoc_?AssociationQ]] := True
MMorphismQ[___] := False


FormMMorphism[from_, to_, by_] := 
	MMorphism[<|
		"Map" -> <|Map[# -> by@# &, MGroupDomain@from]|>,
		"Domain" -> from,
		"CoDomain" -> to
	|>]
MMorphismData[MMorphism[data_], key_] := data[key]
MMorphism /: M_MMorphism[key_] := MMorphismData[M, "Map"][key]


MMorphism /: MakeBoxes[M_MMorphism, form: TraditionalForm] := 
    Module[{},
        SubsuperscriptBox[
            StyleBox["MMorphism", FontSlant -> "Italic"],
            ToBoxes[Length@MGroupDomain@MMorphismData[M, "Domain"], form],
            ToBoxes[Length@MGroupDomain@MMorphismData[M, "CoDomain"], form]
        ]
    ];

MMorphism /: MakeBoxes[M_MMorphism, form: StandardForm] := 
    Module[{above, below, icon},
        icon = Graphics[{
			EdgeForm[Black],
            FaceForm[LightOrange],
            Rectangle[],
            Text[Style["M", Black, 14], {0.5, 0.5}]
        }, ImageSize -> {30, 30}];
        above = {
            BoxForm`SummaryItem[{"Type: ", "MMorphism", SpanFromLeft}],
            BoxForm`SummaryItem[{"n-1: ", ToString@Length@MGroupDomain@MMorphismData[M, "Domain"]<>
            " to "<>ToString@Length@MGroupDomain@MMorphismData[M, "CoDomain"]}]
        };
        below = {
			BoxForm`SummaryItem[{"Kernel: ", MMorphismKernel@M}]
        };
        BoxForm`ArrangeSummaryBox[
            "MMorphism", M, icon, above, below, form,
            "Interpretable" -> True
        ]
    ]


MHomomorphism::OpPrev="The map does not preserve operation."
MHomomorphism[G1_?MGroupQ, G2_?MGroupQ, def_] := Module[
	{domain},
	domain = MGroupDomain[G1];
	If[Or@@Flatten[Table[
		def[G1[x][y]] != G2[def@x][def@y],
		{x, domain}, {y, domain}]],
		Message[MHomomorphism::OpPrev]; Return[$Failed]];
	FormMMorphism[G1, G2, def]
	
]


MMorphismKernel[M_?MMorphismQ] := Module[
	{identity},
	identity = MGroupIdentity[MMorphismData[M, "CoDomain"]];
	Select[MGroupDomain@MMorphismData[M, "Domain"], M@# == identity & ]
]


MIsomorphism::OpPrev="The map does not preserve operation."
MIsomorphism::OneOne="The map is not one-one."
MIsomorphism[G1_?MGroupQ, G2_?MGroupQ, def_] := Module[
	{domain, mapped},
	domain = MGroupDomain[G1];
	If[Or@@Flatten[Table[
		def[G1[x][y]] != G2[def@x][def@y],
		{x, domain}, {y, domain}]],
		Message[MIsomorphism::OpPrev]; Return[$Failed]];
	If[Length[domain] != DeleteDuplicates[def/@domain],
		Message[MIsomorphism::OneOne]; Return[$Failed]];
	FormMMorphism[G1, G2, def]
]


MAutomorphism[G_?MGroupQ, def_] := MIsomorphism[G, G, def]


MInnerAutomorphism::notin="The argument `1` is not a member of the group."
MInnerAutomorphism[G_?MGroupQ, x_] := 
	If[!MemberQ[MGroupDomain[G], x],
		Message[MInnerAutomorphism::notin, x]; $Failed,
	MAutomorphism[G, G[G[x][#]][MElementInverse[G, x]] & ]
]


MActionQ[MAction[association_?AssociationQ]] := True
MActionQ[___] := False


FormMAction::closed="The action is not closed."
FormMAction::one="Property 1 fails."
FormMAction::two="Property 2 fails."
FormMAction[G_, A_, f_] := Module[
	{e = MGroupIdentity@G,
	d = MGroupDomain@G,
	mapping},
	mapping = Association[Rule@@@({#, f@@#} &/@Tuples[{d, A}])];
	If[!SubsetQ[A, Values@mapping],
		Message[FormMAction::closed]; Return[$Failed]];
	If[Or@@@
		(f[#[[1]], f[#[[2]], #[[3]]]] != f[G[#[[1]]][#[[2]]], #[[3]]] & /@
			Tuples[{d, d, A}]),
		Message[FormMAction::one]; Return[$Failed]];
	If[Or@@@
		(f[e, #] != # &/@d),
		Message[FormMAction::two]; Return[$Failed]];
	MAction[<|
		"G" -> G,
		"A" -> A,
		"Mapping" -> mapping
	|>]
]


MActionData[MAction[data_], key_] := data[key]
MAction /: A_MAction[{g_, a_}] := MActionData[A, "Mapping"]{g, a}


MAction /: MakeBoxes[A_MAction, form_] := 
    Module[{above, below, icon},
        icon = Graphics[{
			EdgeForm[Black],
            FaceForm[LightOrange],
            Rectangle[],
            Text[Style["A", Black, 14], {0.5, 0.5}]
        }, ImageSize -> {30, 30}];
        above = {
            BoxForm`SummaryItem[{"Type: ", "MAction", SpanFromLeft}],
            BoxForm`SummaryItem[{"A: ", MActionData[A, "A"]}]
        };
        below = {
			BoxForm`SummaryItem[{"Kernel: ", MActionKernel[A]}]
        };
        BoxForm`ArrangeSummaryBox[
            "MAction", A, icon, above, below, form,
            "Interpretable" -> True
        ]
    ]


MPermutationRepresentation[A_?MActionQ] := 
	MHomomorphism[
		MActionData[A, "G"],
		MPermutationsGroup@Length@MActionData[A, "A"],
		Function[{a}, A[{#, a}]] /@ MActionData[A, "A"] &
	]


MActionKernel[A_?MActionQ] := Module[
	{G, set},
	G = MGroupDomain[MActionData[A, "G"]];
	set = MActionData[A, "A"];
	Select[
		G,
		And@@Table[A[{#, a}] == a, {a, set}] &
	]
]
MElementStabilizer::notin="The argument `1` does not belong to the set."
MElementStabilizer[A_?MActionQ, a_] := With[
	{G = MGroupDomain[MActionData[A, "G"]]},
	If[!MemberQ[MActionData[A, "A"], a],
		Message[MElementStabilizer::notin, a]; $Failed,
		Select[
			G,
			A[{#, a}] == a &
		]
	]
]
MElementOrbit::notin="The argument `1` does not belong to the set."
MElementOrbit[A_?MActionQ, a_] := With[{set = MActionData[A, "A"]},
	If[!MemberQ[set, a],
		Message[MElementOrbit::notin, a]; $Failed,
		A[{#, a}] & /@ set // DeleteDuplicates
	]
]


