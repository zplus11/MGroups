  RowBox[{
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"Length", "@", 
     RowBox[{
      RowBox[{"MSubgroups", "[", 
       RowBox[{
        RowBox[{"MPermutationsGroup", "[", "4", "]"}], ",", 
        RowBox[{"CombinationsLimit", "->", "i"}]}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "2", ",", "3"}], "}"}]}], "]"}]], "Input",
