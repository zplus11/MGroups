Cell[CellGroupData[{

Cell["4.   Subgroups", "Section",
 CellChangeTimes->{{3.930885863714798*^9, 3.9308858653060417`*^9}, {
  3.9308930366991873`*^9, 
  3.9308930377673607`*^9}},ExpressionUUID->"6437322e-99bf-46d0-a6f9-\
f6cc8ba79226"],

Cell["We define a subgroup.", "Text",
 CellChangeTimes->{{3.9308858754986267`*^9, 3.93088588116306*^9}, {
  3.9321945993069787`*^9, 
  3.9321946007390075`*^9}},ExpressionUUID->"df71a539-ed0c-4593-922c-\
701494f30c82"],

Cell[TextData[{
 StyleBox["Definition ",
  FontWeight->"Bold"],
 StyleBox["(Subgroup of a group)",
  FontSlant->"Italic"],
 StyleBox[". ",
  FontWeight->"Bold"],
 "A subset ",
 Cell[BoxData[
  FormBox[
   RowBox[{"H", "\[SubsetEqual]", "G", " "}], TraditionalForm]],
  ExpressionUUID->"94bfcef0-b2b7-416e-b1b2-b1cef267d2c9"],
 " is said to be a subgroup of the group ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "1edda2b7-8820-4690-9809-46c8912e5af3"],
 " if it forms a group itself under the operation of ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],ExpressionUUID->
  "c1c8f788-37ed-4dc2-8674-5b4672f6091e"],
 "."
}], "Text",
 CellChangeTimes->{{3.9308858838638697`*^9, 3.930885941879137*^9}, {
  3.9308868113952293`*^9, 3.9308868602071524`*^9}},
 FontWeight->"Plain",ExpressionUUID->"62418ea7-38ff-45bc-b801-c243f49ca6ae"],

Cell[TextData[{
 "We can check this in ",
 StyleBox["MGroups ",
  FontWeight->"Bold"],
 "as follows:\[LongDash]"
}], "Text",
 CellChangeTimes->{{3.93088686177498*^9, 3.9308868789508953`*^9}, 
   3.9321946035716143`*^9},ExpressionUUID->"5d0ca484-9430-4420-9b58-\
a5b088905dfb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
