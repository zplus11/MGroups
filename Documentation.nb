Cell[CellGroupData[{

Cell["7.   Morphisms", "Section",
 CellChangeTimes->{{3.9311320779503555`*^9, 3.9311320819272194`*^9}, {
  3.931132975983141*^9, 
  3.931132976801651*^9}},ExpressionUUID->"50d44371-c868-4891-ae45-\
9dfb7b98215e"],

Cell[TextData[{
 StyleBox["Definition ",
  FontWeight->"Bold"],
 StyleBox["(Group Homomorphism)",
  FontSlant->"Italic"],
 StyleBox[". ",
  FontWeight->"Bold"],
 "A map \[Phi] from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "156bccf4-36d9-47f9-b02f-d9a83697b964"],
 " to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "041707d0-a6ca-4152-ab2a-141565904312"],
 " is said to be a homomorphism, if and only if it is operation preserving, ",
 StyleBox["i.e.,",
  FontSlant->"Italic"],
 " if ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[Phi]", 
      RowBox[{"(", "xy", ")"}]}], "=", 
     RowBox[{"\[Phi]", 
      RowBox[{"(", "x", ")"}], 
      RowBox[{"\[Phi]", "(", "y", ")"}], " ", 
      RowBox[{"\[ForAll]", "x"}]}]}], ",", 
    RowBox[{"y", "\[Element]", 
     SubscriptBox["G", "1"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "665a9fd3-1b44-48c1-b71c-d4c264e2d380"],
 "."
}], "Text",
 CellChangeTimes->{{3.931132104498022*^9, 
  3.931132240489279*^9}},ExpressionUUID->"8e449d1a-6b14-4921-a6cd-\
d5fe56d28f3b"],

Cell["\<\
To define a Group Homomorphism, you need to define the domain, the codomain, \
and the map\[CloseCurlyQuote]s definition. It can be done as follows:\
\[LongDash]\
\>", "Text",
 CellChangeTimes->{{3.93113224579536*^9, 3.9311323016347733`*^9}, 
   3.9321946520286865`*^9},ExpressionUUID->"416ece37-2a3d-462f-bd9a-\
5c2a7bc7eeea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"phi", "=", 
  RowBox[{"Homomorphism", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AdditiveGroup", "[", "20", "]"}], ",", " ", 
    RowBox[{"(*", " ", "domain", " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"AdditiveGroup", "[", "2", "]"}], ",", " ", 
    RowBox[{"(*", " ", 
     RowBox[{"co", "-", "domain"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Mod", "[", 
      RowBox[{"#", ",", "2"}], "]"}], "&"}]}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "definition", " ", "in", " ", "the", " ", "form", " ", "of", " ", "a", 
     " ", "function"}], " ", "*)"}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9311323032069764`*^9, 3.9311323755013647`*^9}, {
  3.932194071347912*^9, 3.9321940721171713`*^9}},
