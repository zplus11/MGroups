 StyleBox["Definition ",
  FontWeight->"Bold"],
 StyleBox["(Inner Automorphism)",
  FontSlant->"Italic"],
 StyleBox[". ",
  FontWeight->"Bold"],
 "An inner automorphism is an automorphism that is induced by a group element \
",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9c7d262d-35ee-4b25-8a72-c14c96953955"],
 ", with the definition ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", " ", "\[LongRightArrow]", " ", "a"}], " ", "x", " ", 
    SuperscriptBox["a", 
     RowBox[{"-", "1"}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ba69125d-8c31-4a66-9e36-8db2805321a9"],
 "."
}], "Text",
