Cell[TextData[{
 "Here, the top most node is the group ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Z", "4"], TraditionalForm]],ExpressionUUID->
  "27179a38-97ed-48df-9c9a-08058779d0dc"],
 " itself, at the bottom we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", "0", "}"}], TraditionalForm]],ExpressionUUID->
  "3df1fc5d-57bc-4f93-95a9-e58ad7b44652"],
 ", and in the middle we must have ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "2"}], "}"}], TraditionalForm]],ExpressionUUID->
  "bc8cc0bd-b342-4fea-aa39-ce33f0f3e898"],
 ". Hover on the nodes to see details about each subgroup. Let us proceed \
further and see something more exciting:\[LongDash]"
}], "Text",
 CellChangeTimes->{{3.931061523512417*^9, 3.9310615698249226`*^9}, {
   3.9310616156273975`*^9, 3.931061621773269*^9}, 3.9321946164123635`*^9, {
