Cell["Both are equal.", "Text",
 CellChangeTimes->{{3.9310627768269873`*^9, 
  3.9310627808218455`*^9}},ExpressionUUID->"a09ad69b-ca7f-465e-a3e3-\
cfe8ca9b2897"],

Cell[TextData[{
 StyleBox["Definition ",
  FontWeight->"Bold"],
 StyleBox["(Normal Subgroup of a group)",
  FontSlant->"Italic"],
 StyleBox[". ",
  FontWeight->"Bold"],
 "A subgroup ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "730314f2-31c2-440f-b4a1-4e7e41fbdd90"],
 " of ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1f8b631e-9124-41e8-9da0-cb5f77568e63"],
 " is said to be normal in ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "056fd49d-4913-46a5-8379-6e380cb21f1c"],
 " if the left coset by every element is equal to the right counterpart."
}], "Text",
 CellChangeTimes->{
  3.9310623537210646`*^9, {3.9310625194066815`*^9, 
   3.931062553798255*^9}},ExpressionUUID->"c1b530fa-726d-4473-a4a8-\
50808e54a1b4"],

Cell["To find normal subgroups of a group:\[LongDash]", "Text",
 CellChangeTimes->{{3.9310627999886208`*^9, 3.9310628131571884`*^9}, 
   3.932194648792345*^9},ExpressionUUID->"7524b955-4924-480f-ab47-\
b156758cc505"],

