Cell["MGroups Package", "GuideTitle",
 CellID->478013545,ExpressionUUID->"25ba8cc7-e57f-2f4c-b8b8-20de515394ef"],

Cell[TextData[{
 "MGroups package allows exploration of finite groups in terms of their \
Cayley tables, subgroup structures (lattices), group morphisms, actions, and \
so on. It provides extensive functionality to study finite groups using \
functions such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MCayleyTable"]], "paclet:Taggar/MGroups/ref/MCayleyTable", 
    "Taggar Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFunctionSans"]], "InlineFunctionSans",ExpressionUUID->
  "6306ac7e-188f-a244-a5cd-52e778b5f1b0"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["MSubgroups"]], "paclet:Taggar/MGroups/ref/MSubgroups", 
    "Taggar Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFunctionSans"]], "InlineFunctionSans",ExpressionUUID->
  "b937d774-fc6b-4445-afdf-d1c624d0f595"],
 ", and so on."
}], "GuideAbstract",
 CellID->143880982,ExpressionUUID->"b442fd4f-aaeb-7a49-86a1-12b92789b81c"],

