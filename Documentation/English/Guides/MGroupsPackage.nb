Notebook[{

Cell[CellGroupData[{
Cell["MGroups Package", "GuideTitle",
 CellID->478013545,ExpressionUUID->"25ba8cc7-e57f-2f4c-b8b8-20de515394ef"],

Cell[TextData[{
 "MGroups package allows exploration of finite groups in terms of their \
Cayley tables, subgroup structures (lattices), group morphisms, actions, and \
so on. It provides extensive functionality to study finite groups using \
functions such as ",
 Cell[BoxData[
  ButtonBox["MCayleyTable",
   BaseStyle->"Link",
   ButtonData->"paclet:Taggar/MGroups/ref/MCayleyTable"]], "InlineFormula",
  ExpressionUUID->"6306ac7e-188f-a244-a5cd-52e778b5f1b0"],
 ", ",
 Cell[BoxData[
  ButtonBox["MSubgroups",
   BaseStyle->"Link",
   ButtonData->"paclet:Taggar/MGroups/ref/MSubgroups"]], "InlineFormula",
  ExpressionUUID->"b937d774-fc6b-4445-afdf-d1c624d0f595"],
 ", and so on."
}], "GuideAbstract",
 CellChangeTimes->{{3.9576545964557476`*^9, 3.9576546493703766`*^9}, {
  3.9576547326644535`*^9, 3.957654747593807*^9}},
 CellID->143880982,ExpressionUUID->"b442fd4f-aaeb-7a49-86a1-12b92789b81c"]
}, Open  ]],

