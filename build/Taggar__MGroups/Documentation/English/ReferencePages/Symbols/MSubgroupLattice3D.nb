Cell[BoxData[
 Graphics3DBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{{{"r0", "r1", "r2"}, {"r1"}}, {{"r0"}, {"r0"}}, {{"r0", "s0"}, {
        "s0"}}, {{"r0", "s1"}, {"s1"}}, {{"r0", "s2"}, {"s2"}}, {{
        "r0", "r1", "r2", "s0", "s1", "s2"}, {"r1", "s0"}}}, {{{1, 2}, {3, 
       2}, {4, 2}, {5, 2}, {6, 1}, {6, 3}, {6, 4}, {6, 5}}, Null}, {EdgeStyle -> {
         GrayLevel[0.85]}, 
       GraphLayout -> {
        "Dimension" -> 3, "VertexLayout" -> "LayeredDigraphEmbedding"}, 
       VertexLabels -> {{{"r0", "s2"}, {"s2"}} -> Placed[
           
           Grid[{{{"r0", "s2"}}, {"Generated by {s2}"}, {"Order = 2"}}, Frame -> 
            All], Tooltip], {{"r0", "s0"}, {"s0"}} -> Placed[
           
           Grid[{{{"r0", "s0"}}, {"Generated by {s0}"}, {"Order = 2"}}, Frame -> 
            All], Tooltip], {{"r0", "r1", "r2", "s0", "s1", "s2"}, {
           "r1", "s0"}} -> Placed[
           
           Grid[{{{"r0", "r1", "r2", "s0", "s1", "s2"}}, {
             "Generated by {r1, s0}"}, {"Order = 6"}}, Frame -> All], 
           Tooltip], {{"r0"}, {"r0"}} -> Placed[
           
           Grid[{{{"r0"}}, {"Generated by {r0}"}, {"Order = 1"}}, Frame -> 
            All], Tooltip], {{"r0", "s1"}, {"s1"}} -> Placed[
           
           Grid[{{{"r0", "s1"}}, {"Generated by {s1}"}, {"Order = 2"}}, Frame -> 
            All], Tooltip], {{"r0", "r1", "r2"}, {"r1"}} -> Placed[
           
           Grid[{{{"r0", "r1", "r2"}}, {"Generated by {r1}"}, {"Order = 3"}}, 
            Frame -> All], Tooltip]}, 
       VertexStyle -> {{{"r0", "r1", "r2", "s0", "s1", "s2"}, {"r1", "s0"}} -> 
         RGBColor[
          0.28627450980392155`, 0.5137254901960784, 0.996078431372549], {{
           "r0", "s2"}, {"s2"}} -> 
         RGBColor[
          0.28627450980392155`, 0.5137254901960784, 0.996078431372549], {{
