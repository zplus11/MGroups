Cell["\<\
which is the composition of the 191st rotation and reflection about the 61st \
axis, in the Dihedral group of order 480.\
\>", "Text",
 CellChangeTimes->{{3.930880674311534*^9, 3.9308807138780518`*^9}, {
  3.9311335697278833`*^9, 3.931133584709649*^9}, {3.932861561558084*^9, 
  3.93286156331581*^9}},ExpressionUUID->"a815c842-08fe-4f36-831c-\
38ef349ef035"],

Cell["External Direct Products can be formed as follows:\[LongDash]", "Text",
 CellChangeTimes->{{3.930880725348539*^9, 3.930880734349577*^9}, 
   3.932194578285167*^9, {3.932861568495964*^9, 
   3.932861570316472*^9}},ExpressionUUID->"39ba8041-72fc-4fa6-9555-\
93af4a61cc7d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"edp1", "=", 
   RowBox[{"ExternalDirectProduct", "[", 
    RowBox[{
     RowBox[{"AdditiveGroup", "[", "12", "]"}], ",", 
     RowBox[{"MultiplicativeGroup", "[", "20", "]"}], ",", " ", 
     "QuaternionGroup"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.930880739337453*^9, 3.9308807634382024`*^9}, {
  3.930880800967747*^9, 3.930880835077213*^9}, {3.931061355201013*^9, 
  3.9310613583327303`*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"08d59171-9523-4470-a76b-ada080ae7b96"],

Cell[TextData[{
 "The order of this group will be ",
