Cell[CellGroupData[{

Cell["6.   Cosets and Normal Subgroups", "Section",
 CellChangeTimes->{{3.9308930460910854`*^9, 3.930893066749136*^9}, {
  3.931132972906444*^9, 
  3.9311329731260557`*^9}},ExpressionUUID->"8e268fec-51f1-48de-adc5-\
c9da0918aed3"],

Cell[TextData[{
 StyleBox["Definition ",
  FontWeight->"Bold"],
 StyleBox["(Coset)",
  FontSlant->"Italic"],
 StyleBox[". ",
  FontWeight->"Bold"],
 "If ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "21576ae4-634a-4cc2-bb04-f16cbaaba984"],
 " is a subgroup of ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "adb7e797-a77f-4f34-bf81-88631c2f26e3"],
 ", then for some ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5fe31db2-2d4d-45b4-8bc2-1dc6e1f81f4b"],
 " in ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2e19dc7a-f06f-48d2-8219-46395b980539"],
 ", the set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"a", " ", 
     RowBox[{"h", ":", " ", 
      RowBox[{"h", "\[Element]", "H"}]}]}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "58a57f3a-04ac-4504-9799-73545d8054d7"],
 " is called the left coset of ",
 Cell[BoxData[
  FormBox["H", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9d5dc30d-c60b-4a39-84f2-9ecbe853d80b"],
 " in ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8c1f1b99-1518-4b9e-9979-61f7fce7a7c4"],
 " containing ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "854e33bf-8b83-444d-bab4-43e232b96b72"],
 ". Subsequently, corresponding right coset is the set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"h", " ", 
     RowBox[{"a", ":", " ", 
      RowBox[{"h", "\[Element]", "H"}]}]}], "}"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6549dc84-ea06-491f-81ab-0061372574f0"],
 "."
}], "Text",
 CellChangeTimes->{{3.9310623510654526`*^9, 
  3.9310625141591916`*^9}},ExpressionUUID->"b718dedf-9a0a-4c31-bbc9-\
f86a205afd31"],

Cell["You can define cosets in this package as follows:\[LongDash]", "Text",
 CellChangeTimes->{{3.931062574901347*^9, 3.93106258465329*^9}, 
   3.9321946456817064`*^9},ExpressionUUID->"caf54c0b-3ead-43b3-8d23-\
448fabdafc2e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"edp2", "=", 
   RowBox[{"ExternalDirectProduct", "[", 
    RowBox[{
     RowBox[{"MultiplicativeGroup", "[", "8", "]"}], ",", "Klein4Group"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"s", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "\"\<e\>\""}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "\"\<c\>\""}], "}"}]}], "}"}]}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{"any", " ", "one", " ", "subgroup"}], " ", "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9310625909542413`*^9, 3.9310626528667774`*^9}, {
  3.931062706047628*^9, 3.931062715906516*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"e9a24a25-7c57-4286-9ae9-211d24fd6627"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Coset", "[", 
  RowBox[{"edp2", ",", "s", ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "\"\<b\>\""}], "}"}], ",", "\"\<l\>\""}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.931062729742773*^9, 3.9310627720521684`*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"36b111d0-51c1-4861-8480-cbc3e9914c85"],

