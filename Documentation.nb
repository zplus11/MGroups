Cell["Available Groups", "Subsection",
 CellChangeTimes->{{3.9308797335699053`*^9, 
  3.9308797363501577`*^9}},ExpressionUUID->"8c924b7a-f39f-45d0-953d-\
93ced029845e"],

Cell["This package provides the groups as tabulated below.", "Text",
 CellChangeTimes->{{3.93088029179886*^9, 3.930880299758665*^9}, 
   3.932194562923004*^9, {3.9328613963556924`*^9, 
   3.932861401637825*^9}},ExpressionUUID->"d0fca0af-1df7-43df-9061-\
20eee3546fba"],

Cell[BoxData[GridBox[{
   {
    StyleBox["Group",
     FontFamily->"Source Sans Pro",
     FontWeight->"Bold"], 
    StyleBox["Description",
     FontFamily->"Source Sans Pro",
     FontWeight->"Bold"]},
   {
    StyleBox["AdditiveGroup",
     FontFamily->"Source Sans Pro"], 
    StyleBox[
     RowBox[{
      RowBox[{
       SubscriptBox["Z", 
        StyleBox["n",
         FontSlant->"Italic"]], ":", " ", 
       RowBox[{"The", " ", "group", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", "...", ",", " ", 
          RowBox[{
           StyleBox["n",
            FontSlant->"Italic"], "-", "1"}]}], "}"}], " ", "formed"}]}], " ",
       "\[IndentingNewLine]", 
      RowBox[{"under", " ", "addition", " ", "modulo", " ", 
       StyleBox[
        RowBox[{"n", "."}],
        FontSlant->"Italic"]}]}],
     FontFamily->"Source Sans Pro"]},
   {
    StyleBox["MultiplicativeGroup",
     FontFamily->"Source Sans Pro"], 
    StyleBox[
     RowBox[{
      RowBox[{
       SubscriptBox["U", 
        StyleBox["n",
         FontSlant->"Italic"]], ":", " ", 
       RowBox[{"The", " ", "group", " ", 
        RowBox[{"{", 
         RowBox[{"0", "<=", 
          StyleBox["x",
           FontSlant->"Italic"], "<", 
          RowBox[{
           StyleBox["n",
            FontSlant->"Italic"], ":", " ", 
           RowBox[{
            RowBox[{"gcd", 
             RowBox[{"(", 
              RowBox[{
               StyleBox["x",
                FontSlant->"Italic"], ",", 
               StyleBox["n",
                FontSlant->"Italic"]}], ")"}]}], "==", "1"}]}]}], "}"}], " ", 
        "formed"}]}], "\[IndentingNewLine]", 
      RowBox[{"under", " ", "multiplication", " ", "modulo", " ", 
       StyleBox[
        RowBox[{"n", "."}],
        FontSlant->"Italic"]}]}],
     FontFamily->"Source Sans Pro"]},
   {
    StyleBox["DihedralGroupp",
     FontFamily->"Source Sans Pro"], 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["D",
        FontFamily->"Source Sans Pro"], 
       StyleBox["n",
        FontSlant->"Italic"]], 
      StyleBox[":",
       FontFamily->"Source Sans Pro"], 
      StyleBox[" ",
       FontFamily->"Source Sans Pro"], 
      StyleBox[
       RowBox[{
       "The", " ", "group", " ", "of", " ", "symmetries", " ", "of", " ", "a",
         " ", "regular"}],
       FontFamily->"Source Sans Pro"]}], 
     StyleBox[" ",
      FontFamily->"Source Sans Pro"], 
     StyleBox["\[IndentingNewLine]",
      FontFamily->"Source Sans Pro"], 
     StyleBox[
      RowBox[{"polygon", " ", "formed", " ", "under", " ", "their", " ", 
       RowBox[{"composition", "."}]}],
      FontFamily->"Source Sans Pro"]}]},
   {"PermutationsGroup", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["S",
        FontFamily->"Source Sans Pro",
        FontSlant->"Italic"], 
       StyleBox["A",
        FontSlant->"Italic"]], 
      StyleBox[":",
       FontFamily->"Source Sans Pro"], 
      StyleBox[" ",
       FontFamily->"Source Sans Pro"], 
      StyleBox[
       RowBox[{
        RowBox[{"The", " ", "group", " ", "of", 
         StyleBox[
          RowBox[{" ", " "}]], "permutations", " ", "of", " ", "a", " ", 
         "non"}], "-", "empty"}],
       FontFamily->"Source Sans Pro"]}], 
     StyleBox["\[IndentingNewLine]",
      FontFamily->"Source Sans Pro"], 
