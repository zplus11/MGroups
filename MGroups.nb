Cell[TextData[{
 "The package generates subgroups by each subset of cardinality less than or \
equal to 3. However, in some groups, only at most 2 elements are needed to \
exhibit all subgroups. Hence, for quicker outputs, this number can be set \
using ",
 StyleBox["CombinationsLimit ",
  FontWeight->"Bold"],
 "option in commands related to subgroups generation. For example, compare \
the difference while calculating all 30 subgroups of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "4"], TraditionalForm]],ExpressionUUID->
  "b9393e3e-21da-4634-91c4-433b830efca6"],
 ":"
}], "Text",
 CellChangeTimes->{{3.956548650728649*^9, 3.956548779389287*^9}, {
  3.9565488589291153`*^9, 
  3.956548874680126*^9}},ExpressionUUID->"3ba1111d-c7c1-48a0-8ef9-\
e8b6649bae5d"],

