Cell["\<\
This documentation covers each aspect of the package, from basic to advanced. \
We define a group first:\[LongDash]\
\>", "Text",
 CellChangeTimes->{{3.9308796340449896`*^9, 3.9308796572699747`*^9}, 
   3.932194560276261*^9},ExpressionUUID->"a6fc1e2e-2142-4f93-88af-\
343882fd8029"],

Cell[TextData[{
 StyleBox["Definition ",
  FontWeight->"Bold"],
 StyleBox["(Group)",
  FontSlant->"Italic"],
 StyleBox[". ",
  FontWeight->"Bold"],
 "A group is a non-empty set in Mathematics, elements of which follow 4 \
properties namely Closure, Associativity, Existence of Identity, and \
Existence of Inverses under a certain binary operation."
}], "Text",
 CellChangeTimes->{{3.9308796263124013`*^9, 
  3.93087972580543*^9}},ExpressionUUID->"d13eb77d-f741-45d1-b1bc-\
380b0761f7ac"],

