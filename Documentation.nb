Notebook[{

Cell[CellGroupData[{
Cell["MGroups", "Title",
 CellChangeTimes->{{3.9308779509997344`*^9, 
  3.930877955785446*^9}},ExpressionUUID->"e722c318-65c7-44cc-8c6e-\
225f901403be"],

Cell["Finite Group Theory in Mathematica", "Subtitle",
 CellChangeTimes->{{3.9308779576627073`*^9, 
  3.930877965294979*^9}},ExpressionUUID->"dcd7cedb-518b-4c4b-b7c5-\
977c5def7de2"],

Cell[TextData[{
 "Naman Taggar ",
 StyleBox["<namantaggar [dot] 11 [at] gmail [dot] com>",
  FontFamily->"Consolas",
  FontSize->14,
  FontWeight->"Normal"]
}], "Author",
 CellChangeTimes->{{3.93087798737426*^9, 3.9308779942675343`*^9}, {
  3.9308781338227034`*^9, 3.930878151855375*^9}, {3.9316637091351027`*^9, 
  3.9316637221928988`*^9}},ExpressionUUID->"00e1b15c-2bab-4f1e-9da0-\
369f6149c713"],

Cell[TextData[{
 StyleBox["MGroups",
  FontWeight->"Bold"],
 " is a Mathematica Package that implements a part of finite Group Theory. It \
facilitates studying group operations, order and inverses of the group \
elements, Cayley tables, (ordinary and normal) subgroup structures of a \
group, group morphisms and group actions easily. ",
 StyleBox["MGroups ",
  FontWeight->"Bold"],
 "is licensed under the MIT Open-Source License."
}], "Abstract",
 CellChangeTimes->{{3.9308781688420177`*^9, 3.9308783407925406`*^9}, 
   3.9311332357096596`*^9, {3.931663666970807*^9, 3.9316636958303576`*^9}, 
   3.9316638161818*^9, {3.946861110226183*^9, 
   3.9468611573129416`*^9}},ExpressionUUID->"775bbcfe-cb13-4911-8ca0-\
f8e916f53876"],

Cell[CellGroupData[{

Cell["1.   Preface", "Section",
 CellChangeTimes->{{3.930878393507076*^9, 3.9308783974386654`*^9}, {
  3.9308790949521537`*^9, 3.9308790997038813`*^9}, {3.930880353694809*^9, 
  3.9308803553269167`*^9}},ExpressionUUID->"3d24aa9c-8c41-44e4-ad48-\
b16cdafeebc1"],

Cell[TextData[{
 "In ",
 StyleBox["MGroups, ",
  FontWeight->"Bold"],
 "groups are defined in the form of \[OpenCurlyDoubleQuote]Associations\
\[CloseCurlyDoubleQuote] that are the Mathematica version of mappings. Quite \
literally, a group in this package is nothing but its Cayley Table. For \
example, to define the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Z", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3720ff22-3568-4234-891d-3a7990503ce5"],
 " group, all that is needed is to define"
}], "Text",
 CellChangeTimes->{{3.9308784016847873`*^9, 3.930878498719779*^9}, {
  3.9308786409186697`*^9, 
  3.93087865058906*^9}},ExpressionUUID->"15afc5ec-329e-45ba-b355-\
d1b070e47c1d"],

Cell["How 0 operates with 0,", "ItemNumbered",
 CellChangeTimes->{{3.930878517317461*^9, 
  3.9308785306262093`*^9}},ExpressionUUID->"4578af35-f890-4760-9098-\
6c75cd578d62"],

Cell["How 0 operates with 1,", "ItemNumbered",
 CellChangeTimes->{{3.930878517317461*^9, 
  3.9308785364112806`*^9}},ExpressionUUID->"57f9331e-0b2c-4e48-a3d7-\
b8a7c93db60b"],

Cell["How 1 operates with 0, and", "ItemNumbered",
 CellChangeTimes->{{3.930878517317461*^9, 
  3.930878542672632*^9}},ExpressionUUID->"f30272cf-3bcb-436b-b567-\
6669e08b8c7f"],

Cell["How 1 operates with 1.", "ItemNumbered",
 CellChangeTimes->{{3.930878517317461*^9, 
  3.930878546700138*^9}},ExpressionUUID->"24cad461-b4cc-4d34-b432-\
a7196bd82c51"],

Cell["In Mathematica, Associations are of the form", "Text",
 CellChangeTimes->{{3.9308785494854593`*^9, 
  3.930878662713419*^9}},ExpressionUUID->"c4d2233a-1b0a-4272-a65c-\
9937062c1189"],

Cell[BoxData[
 RowBox[{
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"a", "->", "b"}], ",", 
    RowBox[{"c", "->", "d"}], ",", 
    RowBox[{"e", "->", "f"}]}], "|>"}], ";"}]], "Input",
 CellChangeTimes->{{3.9308786784340715`*^9, 3.930878693137302*^9}, 
   3.9308790499695835`*^9, {3.944874073438319*^9, 3.9448740749650216`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"f93f5dc4-fbc9-4d24-89ce-519a1e9a8703"],

Cell[TextData[{
 "which means that ",
 StyleBox["a",
  FontSlant->"Italic"],
 " maps to ",
 StyleBox["b,",
  FontSlant->"Italic"],
 " ",
 StyleBox["c",
  FontSlant->"Italic"],
 " maps to ",
 StyleBox["d,",
  FontSlant->"Italic"],
 " and ",
 StyleBox["e",
  FontSlant->"Italic"],
 " maps to ",
 StyleBox["f",
  FontSlant->"Italic"],
 ". Now, it is only appropriate to see how ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Z", "2"], TraditionalForm]],ExpressionUUID->
  "9681efbf-e0de-45d0-986b-74f9f6e650d6"],
 " will be defined in such a way:\[LongDash]"
}], "Text",
 CellChangeTimes->{{3.9308786951618395`*^9, 3.930878740581036*^9}, {
   3.930878775525582*^9, 3.9308787964941916`*^9}, {3.931063003859776*^9, 
   3.9310630056167507`*^9}, 
   3.9321945518540277`*^9},ExpressionUUID->"1c1d3d1b-fe5f-43cb-9e5c-\
2ff396a575f1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["Z", "2"], "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"0", "->", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"0", "->", "0"}], ",", 
        RowBox[{"1", "->", "1"}]}], "|>"}]}], ",", 
     RowBox[{"1", "->", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"0", "->", "1"}], ",", 
        RowBox[{"1", "->", "0"}]}], "|>"}]}]}], "|>"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9308788006209855`*^9, 3.9308788388376884`*^9}, {
  3.9308789940758142`*^9, 3.93087900034453*^9}, {3.9316638510577807`*^9, 
  3.931663851812126*^9}, {3.9448740581933537`*^9, 3.9448740694592648`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"f9f71b34-6396-449a-88b5-451d0db7c438"],

Cell[TextData[{
 "... which is nothing but nested Associations. Now, if we need to see what \
is 0*0 in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Z", "2"], TraditionalForm]],ExpressionUUID->
  "e3e66e4e-25d1-45b5-ba47-6951038ffd4e"],
 ", we can type"
}], "Text",
 CellChangeTimes->{{3.9308789697153554`*^9, 3.9308790334660683`*^9}, {
  3.93106301188104*^9, 3.931063016502955*^9}, {3.9321943923010683`*^9, 
  3.9321943934623566`*^9}},ExpressionUUID->"fe64afba-4973-411a-9819-\
4f99f194e988"],

