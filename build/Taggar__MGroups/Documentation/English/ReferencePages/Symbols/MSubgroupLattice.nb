Cell[TextData[{
 "CombinationsLimit can be set to define the maximum cardinality of subsets \
that should be used to generate subgroups. For example, all subgroups of ",
 Cell[BoxData[
  SubscriptBox["S", "4"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "72fd6a64-356d-c546-94cc-48b5a5ea12ab"],
 " can be generated by a maximum of 2 elements as the rank of this group is \
2. Hence, compare CombinationsLimit set to 2:"
}], "ExampleText",
 CellID->556403549,ExpressionUUID->"eed69070-b521-794d-bbc9-9ff67d3f2d77"],

