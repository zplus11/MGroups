Cell[CellGroupData[{

Cell["3.   Introduction", "Section",
 CellChangeTimes->{{3.930879587212858*^9, 3.930879616976136*^9}, {
  3.9308803598186264`*^9, 
  3.9308803615930033`*^9}},ExpressionUUID->"d7ec7066-923d-4ae6-badb-\
90460b8acfbb"],

Cell["\<\
This documentation covers each aspect of the package, from basic to advanced. \
We define a group first:\[LongDash]\
\>", "Text",
 CellChangeTimes->{{3.9308796340449896`*^9, 3.9308796572699747`*^9}, 
   3.932194560276261*^9},ExpressionUUID->"a6fc1e2e-2142-4f93-88af-\
343882fd8029"],

Cell[TextData[{
 StyleBox["Definition ",
  FontWeight->"Bold"],
 StyleBox["(Group)",
  FontSlant->"Italic"],
 StyleBox[". ",
  FontWeight->"Bold"],
 "A group is a non-empty set in Mathematics, elements of which follow 4 \
properties namely closure, associativity, existence of identity, and \
existence of inverses under a certain binary operation."
}], "Text",
 CellChangeTimes->{{3.9308796263124013`*^9, 3.93087972580543*^9}, {
  3.9565483342344265`*^9, 
  3.956548343749188*^9}},ExpressionUUID->"d13eb77d-f741-45d1-b1bc-\
380b0761f7ac"],

Cell[CellGroupData[{

Cell["Available Groups", "Subsection",
 CellChangeTimes->{{3.9308797335699053`*^9, 
  3.9308797363501577`*^9}},ExpressionUUID->"8c924b7a-f39f-45d0-953d-\
93ced029845e"],

Cell["This package provides the groups as tabulated below.", "Text",
 CellChangeTimes->{{3.93088029179886*^9, 3.930880299758665*^9}, 
   3.932194562923004*^9, {3.9328613963556924`*^9, 
   3.932861401637825*^9}},ExpressionUUID->"d0fca0af-1df7-43df-9061-\
20eee3546fba"],

Cell[BoxData[GridBox[{
   {
    StyleBox["Group",
     FontFamily->"Source Sans Pro",
     FontWeight->"Bold"], 
    StyleBox["Description",
     FontFamily->"Source Sans Pro",
     FontWeight->"Bold"]},
   {
    StyleBox["MAdditiveGroup",
     FontFamily->"Source Sans Pro"], 
    StyleBox[
     RowBox[{
      RowBox[{
       SubscriptBox["Z", 
        StyleBox["n",
         FontSlant->"Italic"]], ":", " ", 
       RowBox[{"The", " ", "group", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", "...", ",", " ", 
          RowBox[{
           StyleBox["n",
            FontSlant->"Italic"], "-", "1"}]}], "}"}], " ", "formed"}]}], " ",
       "\[IndentingNewLine]", 
      RowBox[{"under", " ", "addition", " ", "modulo", " ", 
       StyleBox[
        RowBox[{"n", "."}],
        FontSlant->"Italic"]}]}],
     FontFamily->"Source Sans Pro"]},
   {
    StyleBox["MMultiplicativeGroup",
     FontFamily->"Source Sans Pro"], 
    StyleBox[
     RowBox[{
      RowBox[{
       SubscriptBox["U", 
        StyleBox["n",
         FontSlant->"Italic"]], ":", " ", 
       RowBox[{"The", " ", "group", " ", 
        RowBox[{"{", 
         RowBox[{"0", "<=", 
          StyleBox["x",
           FontSlant->"Italic"], "<", 
          RowBox[{
           StyleBox["n",
            FontSlant->"Italic"], ":", " ", 
           RowBox[{
            RowBox[{"gcd", 
             RowBox[{"(", 
              RowBox[{
               StyleBox["x",
                FontSlant->"Italic"], ",", 
               StyleBox["n",
                FontSlant->"Italic"]}], ")"}]}], "==", "1"}]}]}], "}"}], " ", 
        "formed"}]}], "\[IndentingNewLine]", 
      RowBox[{"under", " ", "multiplication", " ", "modulo", " ", 
       StyleBox[
        RowBox[{"n", "."}],
        FontSlant->"Italic"]}]}],
     FontFamily->"Source Sans Pro"]},
   {
    StyleBox["MDihedralGroup",
     FontFamily->"Source Sans Pro"], 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["D",
        FontFamily->"Source Sans Pro"], 
       StyleBox["n",
        FontSlant->"Italic"]], 
      StyleBox[":",
       FontFamily->"Source Sans Pro"], 
      StyleBox[" ",
       FontFamily->"Source Sans Pro"], 
      StyleBox[
       RowBox[{
       "The", " ", "group", " ", "of", " ", "symmetries", " ", "of", " ", "a",
         " ", "regular"}],
       FontFamily->"Source Sans Pro"]}], 
     StyleBox[" ",
      FontFamily->"Source Sans Pro"], 
     StyleBox["\[IndentingNewLine]",
      FontFamily->"Source Sans Pro"], 
     StyleBox[
      RowBox[{"polygon", " ", "formed", " ", "under", " ", "their", " ", 
       RowBox[{"composition", "."}]}],
      FontFamily->"Source Sans Pro"]}]},
   {"MPermutationsGroup", 
    RowBox[{
     RowBox[{
      SubscriptBox[
       StyleBox["S",
        FontFamily->"Source Sans Pro",
        FontSlant->"Italic"], 
       StyleBox["A",
        FontSlant->"Italic"]], 
      StyleBox[":",
       FontFamily->"Source Sans Pro"], 
      StyleBox[" ",
       FontFamily->"Source Sans Pro"], 
      StyleBox[
       RowBox[{
        RowBox[{
        "The", " ", "group", " ", "of", "  ", "permutations", " ", "of", " ", 
         "a", " ", "non"}], "-", "empty"}],
       FontFamily->"Source Sans Pro"]}], 
     StyleBox["\[IndentingNewLine]",
      FontFamily->"Source Sans Pro"], 
     StyleBox["               ",
      FontFamily->"Source Sans Pro"], 
     StyleBox[
      RowBox[{"set", " ", "formed", " ", "under", " ", "their", " ", 
       RowBox[{"composition", "."}]}],
      FontFamily->"Source Sans Pro"]}]},
   {
    RowBox[{
     StyleBox[
      RowBox[{"MKlein4Group", " ", "&"}],
      FontFamily->"Source Sans Pro"], 
     StyleBox[" ",
      FontFamily->"Source Sans Pro"], "MQuaternionGroup"}], 
    StyleBox[
     RowBox[{
      RowBox[{"Klein", "'"}], "s", " ", "4", " ", "Group", " ", "and", " ", 
      "the", " ", "Quaternion", " ", 
      RowBox[{"Group", "."}]}],
     FontFamily->"Source Sans Pro"]},
   {"MEDP", 
    StyleBox[
     RowBox[{
     "The", " ", "External", " ", "Direct", " ", "Product", " ", "of", " ", 
      "given", " ", 
      RowBox[{"groups", "."}]}],
     FontFamily->"Source Sans Pro"]}
  },
  GridBoxDividers->{"Columns" -> {{True}}, "Rows" -> {{True}}}]], "Text",
 CellChangeTimes->{{3.9308800050384197`*^9, 3.9308801539864464`*^9}, {
