Cell[TextData[{
 "Most interestingly, you can also see subgroup lattices of groups using this",
 StyleBox[" ",
  FontWeight->"Bold"],
 "package. For example, let us see the subgroup lattice of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Z", "4"], TraditionalForm]],ExpressionUUID->
  "306e3223-1662-4c68-a5c4-f91d63e3f570"],
 "."
}], "Text",
