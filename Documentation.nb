Cell[CellGroupData[{

Cell["8. Group Actions", "Section",
 CellChangeTimes->{{3.946861999822687*^9, 
  3.946862005369918*^9}},ExpressionUUID->"b9b1ecc9-8557-409a-8afe-\
aa583df1c362"],

Cell[TextData[{
 StyleBox["Definition ",
  FontWeight->"Bold"],
 StyleBox["(Group Action)",
  FontSlant->"Italic"],
 StyleBox[". ",
  FontWeight->"Bold"],
 "A group action of a group ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "50c7b2df-52fd-44bc-b538-ca897cbc4afc"],
 " on a set ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "51ae5033-7a4c-4344-b680-2fa90c15e70e"],
 " is a map from ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", "\[Cross]", "A"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3ccf4f94-a178-4657-94e9-fbcd39fe2281"],
 " to A defined by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"g", ",", "a"}], ")"}], "->", 
     RowBox[{
      RowBox[{"g", ".", "a"}], 
      RowBox[{"\[ForAll]", 
       RowBox[{"g", "\[Element]", "G"}]}]}]}], ",", 
    RowBox[{"a", "\[Element]", "A"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1bc8010d-c496-4105-8fe2-e15de39cd33b"],
 " that satisfies the following properties:\n   1.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      SubscriptBox["g", "1"], ".", 
      RowBox[{"(", 
       RowBox[{
        SubscriptBox["g", "2"], ".", "a"}], ")"}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["g", "1"], 
         SubscriptBox["g", "2"]}], ")"}], ".", "a"}], " ", 
      RowBox[{"\[ForAll]", 
       SubscriptBox["g", "1"]}]}]}], ",", 
    RowBox[{
     SubscriptBox["g", "2"], "\[Element]", "G"}], ",", 
    RowBox[{"a", "\[Element]", "A"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e2084bc3-8055-4151-93ea-87d1f39fec58"],
 ", and\n   2.  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"e", ".", "a"}], "=", 
    RowBox[{"a", 
     RowBox[{"\[ForAll]", 
      RowBox[{"a", "\[Element]", "A"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "71311f88-2d96-431d-b1a8-393d5458b1c2"],
 "\nwhere ",
 Cell[BoxData[
  FormBox["e", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "453a1a43-3a94-46d7-a0e2-15ca00148934"],
 " is the identity of ",
 Cell[BoxData[
  FormBox["G", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "324e7d69-235c-45b4-88b4-df4f6b1c4a5c"],
 "."
}], "Text",
 CellChangeTimes->{{3.946862007220292*^9, 
  3.946862182170718*^9}},ExpressionUUID->"1cdf10ee-af04-472e-845e-\
4312bbf90c70"],

