 " to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "A"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7e27cbc9-e883-4b12-b322-5011ea6e227e"],
 " defined by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "->", 
    SubscriptBox["\[Sigma]", "g"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0e1afab2-e1d7-46da-a957-c45945817eff"],
 " is a homomorphism and is called the permutation representation associated \
with the given group action, where:\[LongDash]\n       ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Sigma]", "g"], ":", "A"}], "->", "A"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "473b4997-1017-49e9-8dcf-09553e4d253e"],
 " defined by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[Sigma]", "g"], "(", "a", ")"}], "=", 
    RowBox[{"g", ".", "a"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bf9c1bff-a0c8-4400-866e-5a82b1fd0b5b"],
 " is a permutation on the set ",
 Cell[BoxData[
  FormBox["A", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2555c7b6-4990-47f4-a80d-3d51a3f5299a"],
 " called the permutation induced by ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a3403486-351a-4b13-aa6e-dc4faf95e954"],
 ", for each ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "\[Element]", "A"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d4810bb9-7df4-4625-a246-8167119d6c5a"],
 "."
}], "Text",
 CellChangeTimes->{{3.9468622803873796`*^9, 
  3.9468624501621323`*^9}},ExpressionUUID->"261ecf6a-36c0-4835-8168-\
e31f440fb0d9"],

Cell[TextData[{
 "The associated permutation representation to this action is nothing but the \
identity map from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "A"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2577ca6d-430f-4578-9b31-37e85dc9e19e"],
 " to itself, as shown below:\[LongDash]"
}], "Text",
 CellChangeTimes->{{3.946862257463065*^9, 3.9468622773840837`*^9}, {
  3.9468625322305584`*^9, 
  3.9468625410352054`*^9}},ExpressionUUID->"cd03f6ea-3cc1-48eb-b8c0-\
ec6835495a41"],

