  TagBox[GridBox[{
     {
      StyleBox["\[Null]",
       ShowStringCharacters->False], 
      TagBox["\<\"e\"\>",
       HoldForm], 
      TagBox[
       TemplateBox[{"\"r\"", "1"},
        "Superscript"],
       HoldForm], 
      TagBox[
       TemplateBox[{"\"r\"", "2"},
        "Superscript"],
       HoldForm], 
      TagBox[
       TemplateBox[{"\"r\"", "3"},
        "Superscript"],
       HoldForm], 
      TagBox["\<\"s\"\>",
       HoldForm], 
      TagBox[
